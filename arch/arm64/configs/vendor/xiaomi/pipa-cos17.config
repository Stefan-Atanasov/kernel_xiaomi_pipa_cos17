# pipa ColorOS 17 port: our additions on top of kona-perf + sm8250-common + pipa (Lineage's fragment chain)
# SELinux denials in logcat/dmesg (the ROM's avc tools expect an audit core)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_KALLSYMS_ALL=y
# liyafe's pipa drivers have not run with CFI before: log violations instead of panicking until they are fixed
CONFIG_CFI_PERMISSIVE=y
# ColorOS' init.rc and framework drive cpu.uclamp.{min,max,latency_sensitive} of its cpuctl groups (top-app,
# service-foreground, l-/h-background, ...); Android 17 does not mount schedtune, so without this WALT sees no
# prefer-idle/boost hints and the background caps do nothing
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
