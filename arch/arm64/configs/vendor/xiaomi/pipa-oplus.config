# OPLUS sched_assist family = ColorOS "UI First" (ux_state, binder/lock UX inheritance, im_flag, audio UX, frame boost),
# ported from OPPO's OPD2101 (OPPO Pad, SD870) ColorOS 14 kernel; same options as its kona-perf_defconfig minus the
# stats/IO/memory features
CONFIG_OPLUS_FEATURE_SCHED_ASSIST=y
CONFIG_OPLUS_FEATURE_SCHED_UX_PRIORITY=y
CONFIG_OPLUS_UX_IM_FLAG=y
CONFIG_OPLUS_FEATURE_IM=y
CONFIG_OPLUS_LOCKING_STRATEGY=y
CONFIG_OPLUS_LOCKING_OSQ=y
CONFIG_LOCKING_PROTECT=y
CONFIG_OPLUS_FEATURE_AUDIO_OPT=y
CONFIG_OPLUS_CPU_AUDIO_PERF=y
CONFIG_OPLUS_FEATURE_FRAME_BOOST=y
CONFIG_MMAP_LOCK_OPT=y

# OPPO Hans app freezer kernel channel (netlink 29 + binder/signal/network reports), from the same OPD2101 kernel.
# Without it ColorOS's hans daemon fails, Hans turns itself off and also vetoes the AOSP freezer: no app is frozen.
CONFIG_OPLUS_HANS=y
